From 4a5d31e87f9b1fdce89c5b8833e9dc5891522988 Mon Sep 17 00:00:00 2001
From: sandbox <sandbox@sandbox>
Date: Tue, 17 Nov 2026 16:23:41 -0800
Subject: [PATCH] Add link cable hooks: the caller is the far end of the serial
 port

Until now nothing was ever plugged into the serial port: a transfer on the
internal clock shifted in 0xff, and one waiting on the external clock never
finished.  emulator_set_serial_link() plugs a cable in, and the caller plays
the other Game Boy (or a whole network connection to one):

  - A transfer this Game Boy clocks shifts its 8 bits out in the usual time
    and then waits.  emulator_run_until() returns EMULATOR_EVENT_SERIAL,
    emulator_get_serial_out() says which byte is going out, and
    emulator_serial_complete() hands back the byte that came in, which ends
    the transfer.  The transfer may wait as long as the caller likes, e.g.
    a network round trip.
  - emulator_serial_external() clocks a byte in from the far end when this
    Game Boy waits on the external clock, and returns the byte it sent
    (-1, and nothing happens, when it is not waiting).

Writing SC drops a waiting transfer, as it would end a real one; unplugging
answers a waiting transfer with 0xff.  Without a cable nothing changes.
The four functions are exported from the wasm build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GiTejLHr7D9XaqzmEXZUQ9
---
 src/emscripten/exported.json |  4 +++
 src/emulator.c               | 58 +++++++++++++++++++++++++++++++++++-
 src/emulator.h               | 19 ++++++++++++
 3 files changed, 80 insertions(+), 1 deletion(-)

diff --git a/src/emscripten/exported.json b/src/emscripten/exported.json
index ff2b2ea..fdf4be2 100644
--- a/src/emscripten/exported.json
+++ b/src/emscripten/exported.json
@@ -9,6 +9,7 @@
 "_emulator_get_HL",
 "_emulator_get_hram_ptr",
 "_emulator_get_PC",
+"_emulator_get_serial_out",
 "_emulator_get_SP",
 "_emulator_get_ticks_f64",
 "_emulator_get_wram_ptr",
@@ -18,6 +19,8 @@
 "_emulator_read_state",
 "_emulator_render_background",
 "_emulator_render_vram",
+"_emulator_serial_complete",
+"_emulator_serial_external",
 "_emulator_run_until_f64",
 "_emulator_set_breakpoint",
 "_emulator_set_builtin_palette",
@@ -25,6 +28,7 @@
 "_emulator_set_default_joypad_callback",
 "_emulator_set_PC",
 "_emulator_set_rewind_joypad_callback",
+"_emulator_set_serial_link",
 "_emulator_was_ext_ram_updated",
 "_emulator_write_ext_ram",
 "_emulator_write_mem",
diff --git a/src/emulator.c b/src/emulator.c
index 77b41f4..d77687e 100644
--- a/src/emulator.c
+++ b/src/emulator.c
@@ -477,6 +477,7 @@ typedef struct {
   Bool transferring;
   u8 sb; /* Serial transfer data. */
   u8 transferred_bits;
+  Bool waiting; /* Link cable: all 8 bits are out, the other end's byte is due. */
 } Serial;
 
 typedef struct {
@@ -723,6 +724,7 @@ struct Emulator {
   PaletteRGBA sgb_pal[4];
   CgbColorCurve cgb_color_curve;
   ApuLog apu_log;
+  Bool serial_link; /* A link cable is plugged in; the caller is the far end. */
 #ifdef RGBDS_LIVE
   breakpoints_type breakpoint[BREAKPOINTS_SIZE] __attribute__((aligned(8)));
 #endif
@@ -2638,6 +2640,7 @@ static void write_io(Emulator* e, MaskedAddress addr, u8 value) {
       serial_synchronize(e);
       SERIAL.transferring = UNPACK(value, SC_TRANSFER_START);
       SERIAL.clock = UNPACK(value, SC_SHIFT_CLOCK);
+      SERIAL.waiting = FALSE;
       if (SERIAL.transferring) {
         SERIAL.tick_count = 0;
         SERIAL.transferred_bits = 0;
@@ -4061,11 +4064,23 @@ static void serial_synchronize(Emulator* e) {
     Ticks delta_ticks = TICKS - SERIAL.sync_ticks;
 
     if (UNLIKELY(SERIAL.transferring &&
-                 SERIAL.clock == SERIAL_CLOCK_INTERNAL)) {
+                 SERIAL.clock == SERIAL_CLOCK_INTERNAL && !SERIAL.waiting)) {
       Ticks cpu_tick = e->state.cpu_tick;
       for (; delta_ticks > 0; delta_ticks -= cpu_tick) {
         SERIAL.tick_count += cpu_tick;
         if (VALUE_WRAPPED(SERIAL.tick_count, SERIAL_TICKS)) {
+          if (e->serial_link) {
+            /* A cable is plugged in: SB keeps the byte going out, and the
+             * transfer waits for the far end's byte (emulator_serial_complete). */
+            if (++SERIAL.transferred_bits == 8) {
+              SERIAL.waiting = TRUE;
+              SERIAL.next_intr_ticks = INVALID_TICKS;
+              calculate_next_intr(e);
+              e->state.event |= EMULATOR_EVENT_SERIAL;
+              break;
+            }
+            continue;
+          }
           /* Since we're never connected to another device, always shift in
            * 0xff. */
           SERIAL.sb = (SERIAL.sb << 1) | 1;
@@ -4946,6 +4961,47 @@ Ticks emulator_get_ticks(Emulator* e) {
   return TICKS;
 }
 
+void emulator_set_serial_link(Emulator* e, Bool connected) {
+  serial_synchronize(e);
+  e->serial_link = connected;
+  if (!connected && SERIAL.waiting) {
+    emulator_serial_complete(e, 0xff); /* unplugged: nobody answers */
+  }
+}
+
+int emulator_get_serial_out(Emulator* e) {
+  serial_synchronize(e);
+  return SERIAL.waiting ? SERIAL.sb : -1;
+}
+
+Bool emulator_serial_complete(Emulator* e, u8 in) {
+  serial_synchronize(e);
+  if (!SERIAL.waiting) {
+    return FALSE;
+  }
+  SERIAL.waiting = FALSE;
+  SERIAL.transferring = FALSE;
+  SERIAL.sb = in;
+  SERIAL.tick_count = 0;
+  SERIAL.transferred_bits = 0;
+  INTR.new_if |= IF_SERIAL;
+  calculate_next_serial_intr(e);
+  return TRUE;
+}
+
+int emulator_serial_external(Emulator* e, u8 in) {
+  serial_synchronize(e);
+  if (!e->serial_link || !SERIAL.transferring ||
+      SERIAL.clock != SERIAL_CLOCK_EXTERNAL) {
+    return -1;
+  }
+  u8 out = SERIAL.sb;
+  SERIAL.transferring = FALSE;
+  SERIAL.sb = in;
+  INTR.new_if |= IF_SERIAL;
+  return out;
+}
+
 u32 emulator_get_ppu_frame(Emulator* e) {
   return PPU.frame;
 }
diff --git a/src/emulator.h b/src/emulator.h
index 6d40ed4..3a7d1a9 100644
--- a/src/emulator.h
+++ b/src/emulator.h
@@ -197,6 +197,8 @@ enum {
   EMULATOR_EVENT_UNTIL_TICKS = 0x4,
   EMULATOR_EVENT_BREAKPOINT = 0x8,
   EMULATOR_EVENT_INVALID_OPCODE = 0x10,
+  EMULATOR_EVENT_SERIAL = 0x20, /* Link cable: a byte this Game Boy clocked
+                                 * waits for the far end's answer. */
 };
 
 extern const size_t s_emulator_state_size;
@@ -241,6 +243,23 @@ Result emulator_write_ext_ram_to_file(Emulator*, const char* filename);
 EmulatorEvent emulator_step(Emulator*);
 EmulatorEvent emulator_run_until(Emulator*, Ticks until_ticks);
 
+/* The link cable.  Unplugged (the default), a transfer this Game Boy clocks
+ * shifts in 0xff and one the far end should clock never finishes.  Plugged
+ * in, the caller is the far end:
+ *  - A transfer on the internal clock shifts its 8 bits out in the usual time,
+ *    then waits: emulator_run_until returns EMULATOR_EVENT_SERIAL,
+ *    emulator_get_serial_out says what is going out (-1 when nothing waits),
+ *    and emulator_serial_complete hands back what came in, which ends it.
+ *    The transfer may be left waiting as long as the caller likes.
+ *  - emulator_serial_external clocks one byte in from the far end: when this
+ *    Game Boy waits on the external clock it takes `in` and the byte it sent
+ *    is returned; otherwise nothing happens and it returns -1.
+ * Unplugging answers a waiting transfer with 0xff. */
+void emulator_set_serial_link(Emulator*, Bool connected);
+int emulator_get_serial_out(Emulator*);
+Bool emulator_serial_complete(Emulator*, u8 in);
+int emulator_serial_external(Emulator*, u8 in);
+
 ApuLog* emulator_get_apu_log(Emulator*);
 void emulator_reset_apu_log(Emulator*);
 
-- 
